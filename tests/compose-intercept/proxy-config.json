{
  "servers": [
    {
      "type": "standard",
      "listen-address": "0.0.0.0:8080",
      "enabled": true
    }
  ],
  "timeout-seconds": 30,
  "interception": {
    "enabled": true,
    "https": true,
    "ca-file": "/ca/test_ca.crt",
    "ca-key-file": "/ca/test_ca.key",
    "insecure-skip-verify": true
  },
  "observability": {
    "prometheus-listen-address": "0.0.0.0:9090"
  }
}
