{
  "servers": [
    {
      "type": "standard",
      "listen-address": "127.0.0.1:8080",
      "enabled": true
    }
  ],
  "classifiers": {
    "ipv4-only-sites": {
      "type": "domain",
      "op": "contains",
      "domain": ".legacy-site.com"
    }
  },
  "forwards": [
    {
      "type": "default-network",
      "force-ipv4": true,
      "classifier": {"type": "ref", "id": "ipv4-only-sites"}
    },
    {
      "type": "default-network",
      "classifier": {"type": "true"}
    }
  ]
}
